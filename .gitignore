# CASIA-Iris-Thousand (licensed research dataset — NOT redistributable)
# ---------------------------------------------------------------------
dataset/
datasets/data/
datasets/cache/

# ---------------------------------------------------------------------
# Trained model checkpoints and intermediate artefacts
# (regenerate with run_pipeline.py).
# NB: outputs/* instead of outputs/ so git descends into the folder
# and the negation rules below can keep the small results JSONs.
# ---------------------------------------------------------------------
outputs/*
outputs/results/*
*.pth
*.pt
*.ckpt
*.npz
*.npy
*.pkl
*.joblib

# Keep the small thesis-reported metrics so the Results and Tables
# tab works on the cloud deployment without the heavy checkpoints,
# templates, embeddings or figure PNGs.
!outputs/results/
!outputs/results/*.json
!outputs/results/*.md
!outputs/results/*.log

# ---------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------
# OS-generated preview / junk
# ---------------------------------------------------------------------
desktop.ini
